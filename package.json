{
  "name": "cosmic-garden",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:live-pages:mobile": "playwright test --config playwright.live-pages.mobile.config.ts",
    "test:e2e:cross-browser": "playwright test --config playwright.qa.config.ts",
    "test:network": "node scripts/network-validation.mjs",
    "test:network:live": "node scripts/live-pages-network-validation.mjs",
    "test:soak": "playwright test -c playwright.soak.config.ts",
    "test:pages:interaction": "playwright test -c playwright.pages-interaction.config.ts"
  },
  "dependencies": { "three": "^0.181.1" },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.1",
    "@types/three": "^0.181.0",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
