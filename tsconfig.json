{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "skipLibCheck": true,
    "moduleResolution": "bundler", "allowImportingTsExtensions": false,
    "resolveJsonModule": true, "isolatedModules": true,
    "noEmit": true, "strict": true
  },
  "include": ["src", "tests", "vite.config.ts", "eslint.config.js"]
}
